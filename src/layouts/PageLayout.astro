---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type="website">
  <slot name="head" slot="head" />
  <div class="page">
    <slot />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
</style>
