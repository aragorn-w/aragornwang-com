---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';

export async function getStaticPaths() {
  // Build draft pages in dev for previewing, omit them from production builds.
  const entries = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, tags, description, draft } = entry.data;
const dateLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(date);

// Per-page structured data. BlogPosting is the precise schema.org type for a
// blog post; mirrors the Article schema used on research pages. The canonical
// URL is resolved against the configured site; datePublished is the calendar
// date.
const canonicalUrl = new URL(`/blog/${entry.id}`, Astro.site).href;
const author = {
  '@type': 'Person',
  name: 'Aragorn Wang',
  url: 'https://aragornwang.com',
};
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString().slice(0, 10),
  inLanguage: 'en',
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  author,
  publisher: author,
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
};
---

<ProseLayout title={`${title} | Blog`} description={description}>
  {
    !draft && (
      <script
        is:inline
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(postSchema)}
      />
    )
  }
  <header class="meta-head">
    <div class="meta-row">{dateLabel}</div>
    <h1>{title}</h1>
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Topics">
          {tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
  </header>

  {
    draft && (
      <div class="status-banner" role="status">
        <strong>Draft.</strong> This post is unpublished and only visible in local development.
      </div>
    )
  }

  <Content />

  <hr />
  <p class="back">
    <a href="/blog"><span class="dim">←</span> back to blog</a>
  </p>
</ProseLayout>

<style>
  .meta-head {
    margin-bottom: 1.5em;
  }

  .meta-row {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
  }

  .meta-head h1 {
    font-family: var(--font-mono);
    font-size: 1.7rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .tags {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg-elevated);
  }

  .status-banner {
    margin: 1.5em 0;
    padding: 0.75rem 1rem;
    background: var(--accent-subtle);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg);
  }

  .status-banner strong {
    color: var(--accent);
    font-weight: 500;
  }

  .back {
    margin-top: 2em;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-muted);
  }

  .back a {
    color: inherit;
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }

  .dim {
    color: var(--fg-dim);
  }
</style>
