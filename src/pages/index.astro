---
import PageLayout from '../layouts/PageLayout.astro';
import BootAnimation from '../components/ui/BootAnimation.astro';
import Cursor from '../components/ui/Cursor.astro';
import Prompt from '../components/ui/Prompt.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aragorn Wang',
  url: 'https://aragornwang.com',
  jobTitle: 'Deep Learning Researcher',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Colorado School of Mines',
  },
  sameAs: ['https://linkedin.com/in/aragorn-w-971b561bb', 'https://github.com/aragorn-w'],
};
---

<PageLayout
  title="Aragorn Wang"
  description="AI and robotics undergraduate researcher. CS and math @ Colorado School of Mines. Google SWE intern doing ML for YouTube."
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(personSchema)}
  />

  <BootAnimation />

  <section class="hero" aria-labelledby="hero-name">
    <h1 id="hero-name">Aragorn Wang</h1>
    <p class="tagline">
      AI and robotics undergraduate researcher. CS and math @ Colorado School of Mines. Google SWE
      intern doing ML for YouTube.<Cursor />
    </p>
  </section>

  <section class="currently" aria-label="Currently">
    <div class="prompt-row">
      <Prompt cmd="status" />
    </div>
    <ul class="grid">
      <li>
        <div class="head"><span class="glyph">@</span> ARIA Lab</div>
        <div class="sub">undergraduate deep learning researcher</div>
      </li>
      <li>
        <div class="head"><span class="glyph">→</span> Google (summer 2026)</div>
        <div class="sub">SWE intern, YouTube AI</div>
      </li>
      <li>
        <div class="head">Mines CS '26</div>
        <div class="sub">senior, 4.0 GPA</div>
      </li>
    </ul>
  </section>

  <section class="featured" aria-label="Featured">
    <div class="prompt-row">
      <Prompt cmd="ls -F" />
    </div>
    <ul class="grid features">
      <li>
        <a href="/about" class="card">
          <div class="title">about/</div>
          <p class="desc">Where I'm from, what I'm doing, and what I'm reaching for.</p>
          <span class="cta"><span class="dim">→</span> read</span>
        </a>
      </li>
      <li>
        <a href="/research" class="card">
          <div class="title">research/</div>
          <p class="desc">
            Long-form writeups: ARIA Lab segmentation, Ricoh synthetic data, Northrop ionosphere
            PINNs.
          </p>
          <span class="cta"><span class="dim">→</span> read</span>
        </a>
      </li>
      <li>
        <a href="/projects" class="card">
          <div class="title">projects/</div>
          <p class="desc">Public code, plus case studies of work that can't be public.</p>
          <span class="cta"><span class="dim">→</span> browse</span>
        </a>
      </li>
    </ul>
  </section>
</PageLayout>

<style>
  .hero {
    margin: 3rem 0 1.5rem;
  }
  .hero h1 {
    font-family: var(--font-mono);
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.85rem;
    line-height: 1.15;
  }
  .tagline {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
    max-width: 56ch;
  }

  .currently {
    margin: 3rem 0;
  }

  .prompt-row {
    margin-bottom: 1rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .currently .grid li {
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .currently .head {
    color: var(--fg);
    font-weight: 500;
  }

  .currently .glyph {
    color: var(--accent);
    margin-right: 0.15em;
  }

  .currently .sub {
    margin-top: 0.3rem;
    color: var(--fg-muted);
    font-size: 13px;
  }

  .featured {
    margin: 3rem 0 2rem;
  }

  .features li {
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-elevated);
    color: inherit;
    text-decoration: none;
    height: 100%;
    transition: border-color 120ms ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card .title {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
  }

  .card .desc {
    margin: 0;
    color: var(--fg-muted);
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.5;
  }

  .card .cta {
    margin-top: auto;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .card:hover .cta {
    color: var(--accent);
  }

  .dim {
    color: var(--fg-dim);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .hero h1 {
      font-size: 1.6rem;
    }
  }
</style>
