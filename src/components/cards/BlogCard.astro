---
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, date, description, tags, draft } = entry.data;
const href = `/blog/${entry.id.replace(/\.mdx?$/, '')}`;
const dateLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(date);
---

<article class="card">
  <a href={href} class="link-area">
    <header class="head">
      <h3 class="title">{title}</h3>
      {
        draft && (
          <span class="status" title="Unpublished draft">
            draft
          </span>
        )
      }
    </header>
    <div class="meta">
      <span>{dateLabel}</span>
    </div>
    <p class="desc">{description}</p>
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Topics">
          {tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
    <div class="cta">
      <span class="dim">→</span> read post
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 14px;
    transition: border-color 120ms ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .link-area {
    display: block;
    padding: 1.1rem 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    color: var(--fg);
  }

  .status {
    font-size: 11px;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .meta {
    color: var(--fg-muted);
    font-size: 13px;
    margin-top: 0.25rem;
  }

  .desc {
    color: var(--fg-muted);
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.5;
    margin: 0.75rem 0 0;
  }

  .tags {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    font-size: 12px;
    color: var(--fg-muted);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg);
  }

  .cta {
    margin-top: 0.85rem;
    color: var(--fg-muted);
    font-size: 13px;
  }

  .card:hover .cta {
    color: var(--accent);
  }

  .dim {
    color: var(--fg-dim);
  }
</style>
