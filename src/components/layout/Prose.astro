---
// Prose: typographic wrapper for long-form content (research, blog, About bio).
// Newsreader serif body at 18px / 1.7. Headings stay mono per spec §4.1.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.7;
    color: var(--fg);
  }

  .prose :global(p) {
    margin-bottom: 1.2em;
  }

  .prose :global(h1) {
    font-family: var(--font-mono);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 2em 0 0.6em;
    letter-spacing: -0.01em;
  }

  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 1.8em 0 0.5em;
  }

  .prose :global(h3) {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 1.5em 0 0.4em;
  }

  .prose :global(h1:first-child),
  .prose :global(h2:first-child),
  .prose :global(h3:first-child) {
    margin-top: 0;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1em;
    margin: 1.5em 0;
    color: var(--fg-muted);
    font-style: italic;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1em 0 1em 1.5em;
    padding: 0;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    font-size: 0.85em;
  }

  .prose :global(pre) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1em;
    margin: 1.5em 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
  }

  .prose :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .prose :global(figure) {
    margin: 2em 0;
  }

  .prose :global(figcaption) {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-muted);
    margin-top: 0.5em;
    text-align: center;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 14px;
    margin: 1.5em 0;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.5em 0.75em;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(th) {
    color: var(--fg);
    font-weight: 500;
  }
</style>
