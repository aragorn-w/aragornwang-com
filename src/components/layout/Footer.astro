---
import { Mail } from '@lucide/astro';

const year = new Date().getFullYear();
---

<footer id="contact" class="site-footer">
  <div class="inner">
    <section class="contact">
      <div class="prompt">
        <span class="dim">~/aragorn $</span> contact
      </div>
      <ul class="contact-list">
        <li>
          <a
            href="#"
            class="email-link"
            data-e="119,97,110,103,97,114,97,103,111,114,110,64,103,109,97,105,108,46,99,111,109"
            aria-label="Click to copy Aragorn's email address to the clipboard"
          >
            <Mail size={14} aria-hidden="true" />
            <span class="email-text"></span>
            <span class="email-status" aria-live="polite" aria-atomic="true"></span>
          </a>
        </li>
        <li>
          <a
            href="https://linkedin.com/in/aragorn-w-971b561bb"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.852 3.37-1.852 3.601 0 4.267 2.37 4.267 5.455v6.288zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
            <span>linkedin.com/in/aragorn-w-971b561bb</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/aragorn-w" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path></svg
            >
            <span>github.com/aragorn-w</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="meta">
      <span>© {year} Aragorn Wang</span>
    </section>
  </div>
</footer>

<script is:inline>
  // Footer email handling. The address is encoded as a charcode array in
  // data-e to slow naive scrapers. Clicking the link copies ONLY the
  // plaintext address to the clipboard; no mailto: is ever constructed or
  // navigated to (any mailto: in DOM or JS becomes a scraper target).
  (() => {
    const build = (codes) => String.fromCharCode(...codes.split(',').map(Number));
    document.querySelectorAll('a.email-link').forEach((a) => {
      const addr = build(a.dataset.e);
      const text = a.querySelector('.email-text');
      const status = a.querySelector('.email-status');
      if (text) text.textContent = addr;

      let resetTimer = null;
      const showStatus = (msg, ms) => {
        if (!status) return;
        status.textContent = msg;
        status.classList.add('shown');
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          status.textContent = '';
          status.classList.remove('shown');
        }, ms);
      };

      const selectAddress = () => {
        if (!text) return;
        const range = document.createRange();
        range.selectNodeContents(text);
        const sel = window.getSelection();
        if (!sel) return;
        sel.removeAllRanges();
        sel.addRange(range);
      };

      a.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          if (!navigator.clipboard || !navigator.clipboard.writeText) {
            throw new Error('clipboard-unavailable');
          }
          await navigator.clipboard.writeText(addr);
          showStatus('copied', 1600);
        } catch {
          selectAddress();
          showStatus('select and copy', 2400);
        }
      });
    });
  })();
</script>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-muted);
  }

  .inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .prompt {
    color: var(--fg);
    margin-bottom: 0.5rem;
  }

  .dim {
    color: var(--fg-dim);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }

  .contact-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .contact-list a:hover {
    color: var(--accent);
  }

  .email-status {
    margin-left: 0.4rem;
    font-size: 0.85em;
    color: var(--accent, var(--fg));
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .email-status.shown {
    opacity: 1;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--fg-dim);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    flex-wrap: wrap;
  }
</style>
