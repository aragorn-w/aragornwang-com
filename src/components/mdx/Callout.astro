---
type CalloutKind = 'info' | 'warn' | 'note' | 'tldr';

interface Props {
  type?: CalloutKind;
  title?: string;
}

const { type = 'note', title } = Astro.props;

const labels: Record<CalloutKind, string> = {
  info: 'info',
  warn: 'warning',
  note: 'note',
  tldr: 'tl;dr',
};
---

<aside class:list={['callout', `callout-${type}`]} role="note">
  <div class="head">
    <span class="prompt">{labels[type]}</span>
    {title && <span class="title">{title}</span>}
  </div>
  <div class="body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 1.5em 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-left-width: 3px;
    border-radius: 4px;
    background: var(--bg-elevated);
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.55;
  }

  .callout-info,
  .callout-tldr {
    border-left-color: var(--accent);
  }

  .callout-warn {
    border-left-color: #d97706;
  }

  .callout-note {
    border-left-color: var(--fg-muted);
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
    letter-spacing: 0.02em;
  }

  .prompt {
    color: var(--accent);
    text-transform: lowercase;
  }

  .callout-warn .prompt {
    color: #d97706;
  }

  .title {
    color: var(--fg);
    font-weight: 500;
  }

  .body :global(p) {
    margin: 0 0 0.6em;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
